<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.xlog.app.controllers.UserDetailsController">
  <BorderPane>
    <top>
      <HBox spacing="12" styleClass="topbar" alignment="CENTER_LEFT">
        <padding><Insets top="10" right="16" bottom="10" left="16"/></padding>
        <Label text="Zenith" styleClass="brand"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Dashboard" onAction="#gotoDashboard" styleClass="nav-secondary"/>
        <Button text="User" disable="true" styleClass="nav-primary"/>
        <Button text="Store" onAction="#gotoStore" styleClass="nav-secondary"/>
        <Region prefWidth="16"/>
      </HBox>
    </top>
    <center>
      <VBox spacing="18" styleClass="page-bg">
        <padding><Insets top="14" right="18" bottom="18" left="18"/></padding>
        <Label text="User Profile" styleClass="greeting"/>
        <GridPane hgap="18" vgap="18">
          <columnConstraints><ColumnConstraints percentWidth="45"/><ColumnConstraints percentWidth="55"/></columnConstraints>
          <VBox spacing="14" styleClass="card" GridPane.columnIndex="0">
            <StackPane alignment="CENTER">
              <StackPane fx:id="avatarStack" prefHeight="240" prefWidth="240" styleClass="avatar-box">
                <ImageView fx:id="imgBody" fitWidth="220" fitHeight="220" preserveRatio="true"/>
                <ImageView fx:id="imgEyes" fitWidth="220" fitHeight="220" preserveRatio="true"/>
                <ImageView fx:id="imgDisplay" fitWidth="220" fitHeight="220" preserveRatio="true"/>
              </StackPane>
            </StackPane>
            <Label fx:id="lblName" text="Zenith Seeker" styleClass="profile-name"/>
            <Label fx:id="lblLevel" text="Level 1" styleClass="subdued"/>
            <HBox spacing="8" alignment="CENTER_LEFT"><Label text="XP: 0 / 100" styleClass="subdued"/><Region HBox.hgrow="ALWAYS"/><Label text="Next Level" styleClass="subdued"/></HBox>
            <ProgressBar fx:id="xpBar" progress="0.0" prefHeight="10" styleClass="progress-rounded"/>
            <HBox alignment="CENTER" spacing="10"><Label fx:id="coinsBadge" text="500 Coins" styleClass="coin-chip"/><Button text="Customize Avatar" onAction="#openCustomize" styleClass="cta"/></HBox>
          </VBox>
          <VBox spacing="12" styleClass="card" GridPane.columnIndex="1">
            <Label text="Character Stats" styleClass="section-title"/>
            <HBox spacing="10" styleClass="stat-row intel"><Label text="Intelligence"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="statInt" text="5"/></HBox>
            <HBox spacing="10" styleClass="stat-row str"><Label text="Strength"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="statStr" text="5"/></HBox>
            <HBox spacing="10" styleClass="stat-row chi"><Label text="Chi"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="statChi" text="5"/></HBox>
            <HBox spacing="10" styleClass="stat-row cha"><Label text="Charisma"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="statCha" text="5"/></HBox>
          </VBox>
        </GridPane>
      </VBox>
    </center>
  </BorderPane>
  <!-- Modal -->
  <AnchorPane fx:id="customizeModal" visible="false" pickOnBounds="true" styleClass="modal-backdrop">
    <StackPane prefWidth="Infinity" prefHeight="Infinity" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
      <VBox spacing="16" maxWidth="560" styleClass="modal-card">
        <padding><Insets top="22" right="24" bottom="22" left="24"/></padding>
        <Label text="Customize Avatar" styleClass="modal-title"/>
        <GridPane hgap="16" vgap="10">
          <columnConstraints><ColumnConstraints percentWidth="40"/><ColumnConstraints percentWidth="60"/></columnConstraints>
          <Label text="Body Color" GridPane.rowIndex="0" GridPane.columnIndex="0"/><ComboBox fx:id="cmbBody" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
          <Label text="Eyes" GridPane.rowIndex="1" GridPane.columnIndex="0"/><ComboBox fx:id="cmbEyes" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
          <Label text="Displayable" GridPane.rowIndex="2" GridPane.columnIndex="0"/><ComboBox fx:id="cmbDisplay" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        </GridPane>
        <HBox alignment="CENTER_RIGHT" spacing="8"><Button text="Cancel" onAction="#closeCustomize" styleClass="btn-ghost"/><Button text="Save" onAction="#saveAvatar" styleClass="cta"/></HBox>
      </VBox>
    </StackPane>
  </AnchorPane>
</StackPane>
